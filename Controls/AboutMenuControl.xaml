<UserControl x:Class="ShadowCheat.Controls.AboutMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <ScrollViewer x:Name="AboutMenu" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly"
                  Background="Transparent">
        <StackPanel Margin="20">
            <!-- Header card -->
            <Border Background="#0D0505" BorderBrush="#FF3D1A1A"
                    BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Label Content="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#FFCC0000" FontSize="12"
                               VerticalAlignment="Center" Padding="0,0,4,0"/>
                        <Label Content="KN2 OPEN SOURCE"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               Foreground="#FFCC0000" FontSize="11"
                               VerticalAlignment="Center" Padding="0"/>
                    </StackPanel>
                    <TextBlock Text="No forks permitted. Unauthorized distribution will be reported."
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               Foreground="#FF663333" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Border Width="80" Height="40" Margin="0,0,0,12" HorizontalAlignment="Center"
                            CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FFCC0000"/>
                                <GradientStop Offset="1" Color="#FF8B0000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FFCC0000" Opacity="0.5" BlurRadius="16" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="K" FontFamily="{StaticResource AtkinsonHyperlegible}"
                                   Foreground="White" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KN2" FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="24"
                               FontWeight="Bold" Foreground="#FFF0EBF5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Universal AI Assistant" FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="12" Foreground="#FFA0A0A0"
                               HorizontalAlignment="Center" Margin="0,2,0,8"/>
                    <Border Background="#0D0505" BorderBrush="#FF3D1A1A" BorderThickness="1"
                            CornerRadius="6" Padding="12,4"
                            HorizontalAlignment="Center" Cursor="Hand">
                        <Label x:Name="AboutDesc" Content="v1.0.0"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="11" Foreground="#FFCC0000" Padding="0"/>
                    </Border>
                    <Label x:Name="AboutSpecs" Content="Loading..."
                           FontFamily="{StaticResource AtkinsonHyperlegible}"
                           Foreground="#FFA0A0A0" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Padding="0"/>
                    <Button x:Name="CheckForUpdates" Width="140" Height="36"
                            Margin="0,16,0,0" Cursor="Hand" Click="CheckForUpdates_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#0D0505" BorderBrush="#FF3D1A1A"
                                        BorderThickness="1" CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#CC0000" Opacity="0.25" BlurRadius="6" ShadowDepth="0"/>
                                    </Border.Effect>
                                    <TextBlock Text="Check for Updates" FontWeight="Normal" FontSize="11"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#22CC0000"/>
                                        <Setter Property="Foreground" Value="#FFF0EBF5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- CORE TEAM -->
            <Border Background="#0D0505" BorderBrush="#FF3D1A1A"
                    BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CORE TEAM" FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="10"
                               FontWeight="Bold" Foreground="#FFA0A0A0"
                               Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <UniformGrid x:Name="CoreTeamPanel" Columns="3" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Community -->
            <Border Background="#0D0505" BorderBrush="#FF3D1A1A"
                    BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="And the entire KN2 community"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="11" Foreground="#FFA0A0A0"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Thank you for your support!"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="10" Foreground="#FF663333"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="GitHubButton" Background="#0D0505"
                    BorderBrush="#FF3D1A1A" BorderThickness="1"
                    FontWeight="Normal" FontSize="11" Height="36"
                    Foreground="#FFF0EBF5" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    FontFamily="{StaticResource AtkinsonHyperlegible}" Click="GitHubButton_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FFCC0000"/>
                     <TextBlock Text="View on GitHub" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="DiscordButton" Background="#0D0505"
                    BorderBrush="#FF3D1A1A" BorderThickness="1"
                    FontWeight="Normal" FontSize="11" Height="36"
                    Foreground="#FFF0EBF5" HorizontalAlignment="Stretch"
                    FontFamily="{StaticResource AtkinsonHyperlegible}"
                    Click="DiscordButton_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FF8B0000"/>
                     <TextBlock Text="Join our Discord" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
