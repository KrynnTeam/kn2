<UserControl x:Class="ShadowCheat.Controls.AboutMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <ScrollViewer x:Name="AboutMenu" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly"
                  Background="Transparent">
        <StackPanel Margin="20">
            <!-- Header card -->
            <Border Background="#0F0F1A" BorderBrush="#FF2A2A40"
                    BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Label Content="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#FFB44CFF" FontSize="12"
                               VerticalAlignment="Center" Padding="0,0,4,0"/>
                        <Label Content="KN2 OPEN SOURCE"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               Foreground="#FFB44CFF" FontSize="11"
                               VerticalAlignment="Center" Padding="0"/>
                    </StackPanel>
                    <TextBlock Text="No forks permitted. Unauthorized distribution will be reported."
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               Foreground="#FF554C70" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <Border Width="80" Height="40" Margin="0,0,0,12" HorizontalAlignment="Center"
                            CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FFB44CFF"/>
                                <GradientStop Offset="1" Color="#FFFF2D95"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FFB44CFF" Opacity="0.5" BlurRadius="16" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="K" FontFamily="{StaticResource AtkinsonHyperlegible}"
                                   Foreground="White" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="KN2" FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="24"
                               FontWeight="Bold" Foreground="#FFF0EBF5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Universal AI Assistant" FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="12" Foreground="#FF8880A0"
                               HorizontalAlignment="Center" Margin="0,2,0,8"/>
                    <Border Background="#1A1A2E" BorderBrush="#FF2A2A40" BorderThickness="1"
                            CornerRadius="4" Padding="12,4"
                            HorizontalAlignment="Center" Cursor="Hand">
                        <Label x:Name="AboutDesc" Content="v1.0.0"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="11" Foreground="#FFB44CFF" Padding="0"/>
                    </Border>
                    <Label x:Name="AboutSpecs" Content="Loading..."
                           FontFamily="{StaticResource AtkinsonHyperlegible}"
                           Foreground="#FF8880A0" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Padding="0"/>
                    <Button x:Name="CheckForUpdates"
                            Background="#0F0F1A" BorderBrush="#FF2A2A40"
                            BorderThickness="1" Content="Check for Updates" FontWeight="Normal" FontSize="11"
                            Height="32" Foreground="#FFF0EBF5" Width="140"
                            Margin="0,16,0,0" FontFamily="{StaticResource AtkinsonHyperlegible}"
                            Click="CheckForUpdates_Click" Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- CORE TEAM -->
            <Border Background="#0F0F1A" BorderBrush="#FF2A2A40"
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CORE TEAM" FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="10"
                               FontWeight="Bold" Foreground="#FF8880A0"
                               Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <UniformGrid x:Name="CoreTeamPanel" Columns="3" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Community -->
            <Border Background="#0F0F1A" BorderBrush="#FF2A2A40"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="12" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="And the entire KN2 community"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="11" Foreground="#FF8880A0"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Thank you for your support!"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               FontSize="10" Foreground="#FF554C70"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="GitHubButton" Background="#0F0F1A"
                    BorderBrush="#FF2A2A40" BorderThickness="1"
                    FontWeight="Normal" FontSize="11" Height="36"
                    Foreground="#FFF0EBF5" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    FontFamily="{StaticResource AtkinsonHyperlegible}" Click="GitHubButton_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FFB44CFF"/>
                    <TextBlock Text="View on GitHub" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="DiscordButton" Background="#0F0F1A"
                    BorderBrush="#FF2A2A40" BorderThickness="1"
                    FontWeight="Normal" FontSize="11" Height="36"
                    Foreground="#FFF0EBF5" HorizontalAlignment="Stretch"
                    FontFamily="{StaticResource AtkinsonHyperlegible}"
                    Click="DiscordButton_Click" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="#FFFF2D95"/>
                    <TextBlock Text="Join our Discord" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
