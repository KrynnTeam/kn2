<UserControl x:Class="ShadowCheat.Controls.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Acerca de KN2" FontSize="20" FontWeight="Bold"
                   Foreground="White" FontFamily="Segoe UI"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Logo + name card -->
                <Border CornerRadius="14" Background="#0D1117" BorderThickness="1" BorderBrush="#FF1E293B"
                        Padding="24" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF00A8FF"/>
                                    <GradientStop Offset="1" Color="#FF8B5CF6"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="KN2" FontFamily="Segoe UI" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KN2" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                            <TextBlock Text="AI-Powered Gaming Performance" FontSize="13" Foreground="#FF94A3B8"
                                       FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            <TextBlock x:Name="AboutDesc" Text="v1.0.0" FontSize="11" Foreground="#FF475569"
                                       FontFamily="Segoe UI" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- System specs -->
                <Border CornerRadius="14" Background="#0D1117" BorderThickness="1" BorderBrush="#FF1E293B"
                        Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="System Specifications" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <TextBlock x:Name="AboutSpecs" Text="Loading..." FontSize="12" Foreground="#FF94A3B8"
                                   FontFamily="Segoe UI" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Core team -->
                <Border CornerRadius="14" Background="#0D1117" BorderThickness="1" BorderBrush="#FF1E293B"
                        Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Core Team" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <UniformGrid x:Name="CoreTeamPanel" Columns="3"/>
                    </StackPanel>
                </Border>

                <!-- Links -->
                <Border CornerRadius="14" Background="#0D1117" BorderThickness="1" BorderBrush="#FF1E293B"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Community" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                        <Button x:Name="GitHubButton" Height="40" Cursor="Hand" Margin="0,0,0,8"
                                BorderThickness="0" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiDark">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="#0AFFFFFF" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="View on GitHub" Foreground="#FF94A3B8" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="DiscordButton" Height="40" Cursor="Hand"
                                BorderThickness="0" FontFamily="Segoe UI" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="10" Background="#0AFFFFFF" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Join our Discord" Foreground="#FF94A3B8" FontFamily="Segoe UI"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>