<UserControl x:Class="ShadowCheat.Controls.LearnPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF1E293B"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Guia de Uso" FontSize="20" FontWeight="Bold"
                   Foreground="White" FontFamily="Segoe UI"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Step 1 -->
                <Border Style="{StaticResource StepCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                Background="#1200A8FF">
                            <TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="#FF00A8FF"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Instalar KN2" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Descarga e instala KN2 desde la fuente oficial. Asegurate de tener .NET 9 Runtime instalado."
                                       FontSize="12" Foreground="#FF94A3B8" FontFamily="Segoe UI" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 2 -->
                <Border Style="{StaticResource StepCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                Background="#128B5CF6">
                            <TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#FF8B5CF6"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Configurar Deteccion" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="En la seccion Cheats, ajusta el radio de escaneo, tolerancia de color y velocidad de escaneo para tu juego."
                                       FontSize="12" Foreground="#FF94A3B8" FontFamily="Segoe UI" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 3 -->
                <Border Style="{StaticResource StepCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                Background="#1210B981">
                            <TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#FF10B981"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Seleccionar Modelo" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Ve a Juegos y carga un modelo ONNX compatible. Puedes arrastrar archivos directamente al area de carga."
                                       FontSize="12" Foreground="#FF94A3B8" FontFamily="Segoe UI" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Step 4 -->
                <Border Style="{StaticResource StepCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Center"
                                Background="#12F59E0B">
                            <TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="#FFF59E0B"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Activar y Jugcar" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Activa los modulos que necesites, inicia tu juego y KN2 operara automaticamente en segundo plano."
                                       FontSize="12" Foreground="#FF94A3B8" FontFamily="Segoe UI" TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>