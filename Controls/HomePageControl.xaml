<UserControl x:Class="ShadowCheat.Controls.HomePageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent">
    <Grid Margin="40,30,40,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Center branding -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Logo -->
            <Border Width="100" Height="100" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF00A8FF"/>
                        <GradientStop Offset="1" Color="#FF8B5CF6"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect x:Name="LogoBreathing" Color="#00A8FF" Opacity="0.6" BlurRadius="36" ShadowDepth="0"/>
                </Border.Effect>
                <TextBlock Text="KN2" FontFamily="Segoe UI" Foreground="White" FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="KN2" FontSize="36" FontWeight="Bold" Foreground="White"
                       FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="AI-Powered Gaming Performance" FontSize="15" FontWeight="Light"
                       Foreground="#FF94A3B8" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,48"/>

            <!-- Decorative line -->
            <Border Width="200" Height="2" HorizontalAlignment="Center" Margin="0,0,0,48" CornerRadius="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="Transparent"/>
                        <GradientStop Offset="0.5" Color="#FF00A8FF"/>
                        <GradientStop Offset="1" Color="Transparent"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Minimal feature icons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                <!-- AI -->
                <StackPanel Margin="0,0,40,0">
                    <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8"
                            Background="#1200A8FF">
                        <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="#FF00A8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AI Engine" FontSize="11" Foreground="#FF94A3B8" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Speed -->
                <StackPanel Margin="0,0,40,0">
                    <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8"
                            Background="#128B5CF6">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Performance" FontSize="11" Foreground="#FF94A3B8" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Shield -->
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8"
                            Background="#1210B981">
                        <TextBlock Text="&#xE730;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Protection" FontSize="11" Foreground="#FF94A3B8" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Bottom status -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Border Width="6" Height="6" CornerRadius="3" Background="#FF10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="System Active" FontSize="11" Foreground="#FF475569" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="v1.0.0" FontSize="11" Foreground="#FF475569" FontFamily="Segoe UI"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</UserControl>