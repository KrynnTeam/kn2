<Window x:Class="ShadowCheat.Controls.ColorPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Color Picker" Height="400" Width="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Border CornerRadius="{StaticResource M3ShapeExtraLarge}"
            Background="{StaticResource M3Background}"
            BorderBrush="{StaticResource M3OutlineVariant}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="{StaticResource M3Shadow}" Opacity="0.5" BlurRadius="24" ShadowDepth="4"/>
        </Border.Effect>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" Text="Color Picker" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource M3OnSurface}" HorizontalAlignment="Center" Margin="0,4,0,12" />

            <Canvas Grid.Row="1" x:Name="ColorCanvas" Width="250" Height="250"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="Canvas_MouseDown"
                    MouseMove="Canvas_MouseMove"
                    MouseLeftButtonUp="Canvas_MouseUp"
                    Cursor="Cross">
                <Ellipse x:Name="ColorEllipse" Width="250" Height="250" />
                <Ellipse x:Name="SelectorDot" Width="16" Height="16" Fill="White" Stroke="Black" StrokeThickness="1"
                         Canvas.Left="117" Canvas.Top="117" IsHitTestVisible="False">
                    <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="Black" Opacity="0.5"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Brightness"
                           Foreground="{StaticResource M3OnSurfaceVariant}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="1"
                        ValueChanged="BrightnessSlider_ValueChanged" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="PreviewEllipse" Grid.Column="0" Width="30" Height="30" Fill="#722ED1"
                         Stroke="{StaticResource M3Outline}" StrokeThickness="1" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="HexTextBox" Text="#722ED1"
                         Foreground="{StaticResource M3OnSurface}"
                         Background="{StaticResource M3Surface}"
                         BorderBrush="{StaticResource M3Outline}" BorderThickness="1"
                         FontFamily="Consolas" FontSize="14" Padding="6" VerticalAlignment="Center"
                         TextChanged="HexTextBox_TextChanged" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ApplyButton" Content="Apply"
                        Background="{StaticResource M3Primary}"
                        Foreground="{StaticResource M3OnPrimary}" BorderThickness="0"
                        Padding="8,6" Margin="0,0,5,0" Click="ApplyButton_Click" Cursor="Hand" />
                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancel"
                        Background="{StaticResource M3SurfaceVariant}"
                        Foreground="{StaticResource M3OnSurface}" BorderThickness="0"
                        Padding="8,6" Margin="5,0,0,0" Click="CancelButton_Click" Cursor="Hand" />
            </Grid>
        </Grid>
    </Border>
</Window>
