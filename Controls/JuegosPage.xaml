<UserControl x:Class="ShadowCheat.Controls.JuegosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="GameCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="#0D0505"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF3D1A1A"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="240"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation Duration="0:0:0.2" Storyboard.TargetProperty="BorderBrush.Thickness" To="2"/>
                                <ColorAnimation Duration="0:0:0.2" Storyboard.TargetProperty="BorderBrush.Color" To="#FFCC0000"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation Duration="0:0:0.25" Storyboard.TargetProperty="BorderBrush.Thickness" To="1"/>
                                <ColorAnimation Duration="0:0:0.25" Storyboard.TargetProperty="BorderBrush.Color" To="#FF3D1A1A"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Juegos Soportados" FontSize="22" FontWeight="Bold"
                   Foreground="White" FontFamily="Segoe UI"/>

        <!-- Sub-header -->
        <TextBlock Grid.Row="1" Text="Selecciona un shooter para configurar sus cheats" FontSize="12"
                   Foreground="#FFA0A0A0" FontFamily="Segoe UI" Margin="0,4,0,0"/>

        <!-- Game grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel HorizontalAlignment="Left">
                <!-- Shooter placeholder 1 -->
                <Border Style="{StaticResource GameCard}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Background="#12CC0000">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                           Foreground="#FFCC0000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Shooter #1" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <Border Background="#1A0A0A0A" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="Coming Soon" FontSize="9" Foreground="#FF663333"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shooter placeholder 2 -->
                <Border Style="{StaticResource GameCard}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Background="#128B0000">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                           Foreground="#FF8B0000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Shooter #2" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            <Border Background="#1A0A0A0A" CornerRadius="6" Padding="8,4" Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="Coming Soon" FontSize="9" Foreground="#FF663333"
                                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shooter placeholder 3 -->
                <Border Style="{StaticResource GameCard}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Background="#12C0C0C0">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                           Foreground="#FFC0C0C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Shooter #3" FontSize="14" FontWeight="SemiBold" Foreground="White"
