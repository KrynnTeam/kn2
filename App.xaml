<Application x:Class="ShadowCheat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Red" SecondaryColor="DeepOrange" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ========== CORE GOTH PALETTE ========== -->
            <SolidColorBrush x:Key="KN2Primary" Color="#FFCC0000"/>
            <SolidColorBrush x:Key="KN2Secondary" Color="#FF8B0000"/>
            <SolidColorBrush x:Key="KN2Accent" Color="#FFC0C0C0"/>
            <SolidColorBrush x:Key="KN2Warning" Color="#FFD4A017"/>
            <SolidColorBrush x:Key="KN2Danger" Color="#FFFF2020"/>

            <!-- ========== BACKGROUNDS ========== -->
            <SolidColorBrush x:Key="KN2BgDeep" Color="#FF050000"/>
            <SolidColorBrush x:Key="KN2BgBase" Color="#FF0A0505"/>
            <SolidColorBrush x:Key="KN2BgSurface" Color="#FF150A0A"/>
            <SolidColorBrush x:Key="KN2BgElevated" Color="#FF1A0D0D"/>
            <SolidColorBrush x:Key="KN2BgCard" Color="#FF0D0505"/>

            <!-- ========== BORDERS ========== -->
            <SolidColorBrush x:Key="KN2BorderDefault" Color="#FF3D1A1A"/>
            <SolidColorBrush x:Key="KN2BorderSubtle" Color="#FF2A0F0F"/>
            <SolidColorBrush x:Key="KN2BorderFocus" Color="#FFCC0000"/>

            <!-- ========== TEXT ========== -->
            <SolidColorBrush x:Key="KN2TextPrimary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="KN2TextSecondary" Color="#FFA0A0A0"/>
            <SolidColorBrush x:Key="KN2TextMuted" Color="#FF663333"/>
            <SolidColorBrush x:Key="KN2TextAccent" Color="#FFCC0000"/>

            <!-- ========== GLOWS ========== -->
            <SolidColorBrush x:Key="KN2GlowRed" Color="#33CC0000"/>
            <SolidColorBrush x:Key="KN2GlowCrimson" Color="#338B0000"/>
            <SolidColorBrush x:Key="KN2GlowSilver" Color="#33C0C0C0"/>

            <!-- ========== GLASS ========== -->
            <SolidColorBrush x:Key="KN2GlassBg" Color="#1A0A0505"/>
            <SolidColorBrush x:Key="KN2GlassBorder" Color="#1ACC0000"/>

            <!-- ========== M3 COMPAT ========== -->
            <SolidColorBrush x:Key="M3Primary" Color="#FFCC0000"/>
            <SolidColorBrush x:Key="M3OnPrimary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="M3PrimaryContainer" Color="#FF8B0000"/>
            <SolidColorBrush x:Key="M3OnPrimaryContainer" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="M3Secondary" Color="#FF8B0000"/>
            <SolidColorBrush x:Key="M3OnSecondary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="M3SecondaryContainer" Color="#FF5C0000"/>
            <SolidColorBrush x:Key="M3OnSecondaryContainer" Color="#FFFFD0D0"/>
            <SolidColorBrush x:Key="M3Surface" Color="#FF150A0A"/>
            <SolidColorBrush x:Key="M3OnSurface" Color="#FFE0D0D0"/>
            <SolidColorBrush x:Key="M3SurfaceVariant" Color="#FF1A0D0D"/>
            <SolidColorBrush x:Key="M3OnSurfaceVariant" Color="#FFA0A0A0"/>
            <SolidColorBrush x:Key="M3Background" Color="#FF050000"/>
            <SolidColorBrush x:Key="M3OnBackground" Color="#FFE0D0D0"/>
            <SolidColorBrush x:Key="M3Outline" Color="#FF663333"/>
            <SolidColorBrush x:Key="M3OutlineVariant" Color="#FF4A2020"/>
            <Color x:Key="M3Shadow">#66000000</Color>

            <SolidColorBrush x:Key="ThemeColor" Color="#FFCC0000"/>
            <SolidColorBrush x:Key="ThemeColorDark" Color="#FF8B0000"/>
            <SolidColorBrush x:Key="ThemeColorLight" Color="#FFFF2020"/>
            <SolidColorBrush x:Key="ThemeGradientDark" Color="#FF050000"/>
            <SolidColorBrush x:Key="ThemeColorTransparent" Color="#33CC0000"/>
            <SolidColorBrush x:Key="ThemeColorSemiTransparent" Color="#66CC0000"/>

            <!-- ========== NEON COMPAT ========== -->
            <SolidColorBrush x:Key="NeonBgDeep" Color="#FF050000"/>
            <SolidColorBrush x:Key="NeonSurface" Color="#FF150A0A"/>
            <SolidColorBrush x:Key="NeonSurfaceAlt" Color="#FF1A0D0D"/>
            <SolidColorBrush x:Key="NeonPrimary" Color="#FFCC0000"/>
            <SolidColorBrush x:Key="NeonSecondary" Color="#FF8B0000"/>
            <SolidColorBrush x:Key="NeonTertiary" Color="#FFC0C0C0"/>
            <SolidColorBrush x:Key="NeonBorder" Color="#FF3D1A1A"/>
            <SolidColorBrush x:Key="NeonBorderLight" Color="#FF4A2020"/>
            <SolidColorBrush x:Key="NeonTextPrimary" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="NeonTextSecondary" Color="#FFA0A0A0"/>
            <SolidColorBrush x:Key="NeonTextMuted" Color="#FF663333"/>
            <SolidColorBrush x:Key="NeonGlowPurple" Color="#33CC0000"/>
            <SolidColorBrush x:Key="NeonGlowMagenta" Color="#338B0000"/>
            <SolidColorBrush x:Key="NeonGlowCyan" Color="#33C0C0C0"/>

            <!-- ========== SHAPES ========== -->
            <CornerRadius x:Key="M3ShapeSmall">6</CornerRadius>
            <CornerRadius x:Key="M3ShapeMedium">10</CornerRadius>
            <CornerRadius x:Key="M3ShapeLarge">16</CornerRadius>
            <CornerRadius x:Key="M3ShapeExtraLarge">24</CornerRadius>

            <!-- ========== TYPOGRAPHY ========== -->
            <FontFamily x:Key="AtkinsonHyperlegible">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Consolas</FontFamily>
            <sys:Double x:Key="M3FontSizeLabel">11</sys:Double>
            <sys:Double x:Key="M3FontSizeBody">13</sys:Double>
            <sys:Double x:Key="M3FontSizeTitle">16</sys:Double>
            <sys:Double x:Key="M3FontSizeHeadline">20</sys:Double>

            <!-- ========== EFFECTS ========== -->
            <VisualBrush x:Key="Scanlines" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                <VisualBrush.Visual>
                    <Rectangle Width="4" Height="4" Fill="#06000000"/>
                </VisualBrush.Visual>
            </VisualBrush>

            <!-- ========== FOCUS ========== -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="Thumb" BasedOn="{StaticResource {x:Type Thumb}}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource M3OnSurface}" />
                <Style.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{StaticResource M3PrimaryContainer}" />
                        <Setter Property="Foreground" Value="{StaticResource M3OnPrimaryContainer}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1A0D0D" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE0D0D0" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFCC0000" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />

            <Style x:Key="GhostButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter RecognizesAccessKey="False" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#1A0D0D"/>
                <Setter Property="Foreground" Value="#FFE0D0D0"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="BorderBrush" Value="#FF663333"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>

            <!-- Custom ComboBox with red-bordered popup -->
            <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
                <Border Background="Transparent">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="#FFCC0000" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                </Border>
            </ControlTemplate>

            <Style x:Key="GothComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Border" Background="#FF0D0505"
                                        BorderBrush="#FF4A2020" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="1" Template="{StaticResource ComboBoxToggleButton}"
                                                      Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                        <ContentPresenter x:Name="ContentSite" Margin="8,0,28,0" VerticalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    </Grid>
                                </Border>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border CornerRadius="8" Background="#FF150A0A"
                                            BorderBrush="#FFCC0000" BorderThickness="1"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#CC0000" Opacity="0.25" BlurRadius="12" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
