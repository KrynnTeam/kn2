<UserControl x:Class="ShadowCheat.UILibrary.ASlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="282.5" Height="68">
    <Grid Height="72">
        <Border Height="72" Background="#0D0505"
                CornerRadius="0" BorderThickness="1,0,1,0" BorderBrush="#FF3D1A1A">
            <Grid>
                <Label x:Name="SliderTitle" Padding="12,8,0,0"
                       FontFamily="{StaticResource AtkinsonHyperlegible}"
                       Content="Slider" Foreground="#FFF0EBF5"
                       VerticalContentAlignment="Center" FontSize="13"
                       VerticalAlignment="Top" Height="28" HorizontalAlignment="Left" Width="172" />
                <Label x:Name="AdjustNotifier" Padding="0,10,12,0"
                       FontFamily="{StaticResource MonoFont}"
                       Content="0.00" Foreground="#FFA0A0A0"
                       VerticalContentAlignment="Center" FontSize="11"
                       VerticalAlignment="Top" Height="28" HorizontalAlignment="Right"
                       HorizontalContentAlignment="Right" />
                <Slider x:Name="Slider" Margin="35,34,35,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource KN2Primary}"
                        IsSnapToTickEnabled="True" Value="2" TickFrequency="0.01"
                        Minimum="0" Maximum="100" />
                <Button x:Name="SubtractOne" Content="&#xE949;"
                        HorizontalAlignment="Left" Height="22" Width="22" Margin="8,0,0,6"
                        VerticalAlignment="Bottom"
                        Padding="0" FontFamily="Segoe MDL2 Assets" BorderThickness="0"
                        FontSize="10" Foreground="#FFCC0000"
                        Style="{StaticResource GhostButtonStyle}" Cursor="Hand" />
                <Button x:Name="AddOne" Content="&#xE948;"
                        HorizontalAlignment="Right" Height="22" Width="22" Margin="0,0,8,6"
                        VerticalAlignment="Bottom"
                        Padding="0" FontFamily="Segoe MDL2 Assets" BorderThickness="0"
                        FontSize="10" Foreground="#FFCC0000"
                        Style="{StaticResource GhostButtonStyle}" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
