<UserControl x:Class="ShadowCheat.UILibrary.AColorChanger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="282.5" d:DesignHeight="40">
    <Grid Height="48">
        <Border Height="48" Background="#0D0505"
                CornerRadius="0" BorderThickness="1,0,1,0" BorderBrush="#FF3D1A1A">
            <Grid>
                <Label x:Name="ColorChangerTitle" Padding="12,0,0,0"
                       FontFamily="{StaticResource AtkinsonHyperlegible}"
                       Content="Color" Foreground="#FFF0EBF5"
                       VerticalContentAlignment="Center" FontSize="13"
                       HorizontalAlignment="Left" />
                <Border x:Name="ColorChangingBorder" HorizontalAlignment="Right" Width="22"
                        Margin="0,0,10,0" Height="22"
                        Background="{DynamicResource KN2Primary}" CornerRadius="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFCC0000" Opacity="0.5" BlurRadius="8" ShadowDepth="0"/>
                    </Border.Effect>
                </Border>
                <Button x:Name="Reader" Style="{StaticResource GhostButtonStyle}" Height="44" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
