<UserControl x:Class="ShadowCheat.UILibrary.AFileLocator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="282.5" Height="76">
    <Grid>
        <Border Height="80" Background="#0D0505"
                CornerRadius="10" BorderThickness="1" BorderBrush="#FF3D1A1A">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="8" ShadowDepth="2"/>
            </Border.Effect>
    <Grid Margin="0,0,0,6">
                <Label x:Name="DropdownTitle" Padding="12,10,0,0"
                       FontFamily="{StaticResource AtkinsonHyperlegible}"
                       Content="File Path" Foreground="#FFF0EBF5"
                       VerticalContentAlignment="Center" FontSize="13"
                       VerticalAlignment="Top" Height="36" />
                <TextBox x:Name="FileLocationTextbox"
                         BorderBrush="#FF4A2020"
                         Foreground="#FFF0EBF5" BorderThickness="1"
                         TextWrapping="Wrap" Text="" VerticalAlignment="Top"
                         FontFamily="{StaticResource MonoFont}"
                         Padding="8,0" Background="#FF0D0505"
                         Margin="12,36,45,0" Height="30" IsReadOnly="True"
                         VerticalContentAlignment="Center" />
                <Button x:Name="OpenFileB" Content="&#xE838;"
                        HorizontalAlignment="Right" Height="30" Width="30"
                        Margin="0,0,10,8" VerticalAlignment="Bottom"
                        Padding="0" FontFamily="Segoe MDL2 Assets" BorderThickness="0" FontSize="13"
                        Foreground="#FFCC0000"
                        Style="{StaticResource GhostButtonStyle}" Click="OpenFileB_Click" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
