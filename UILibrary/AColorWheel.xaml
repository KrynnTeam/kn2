<UserControl x:Class="ShadowCheat.UILibrary.AColorWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Ant="clr-namespace:AntWpf.Controls;assembly=AntWpf"
             mc:Ignorable="d"
             d:DesignWidth="282.5" d:DesignHeight="310">
    <Grid>
        <Border x:Name="ColorWheelView" Height="310" Background="#0F0F1A"
                CornerRadius="6" BorderThickness="1" BorderBrush="#FF2A2A40">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="8" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Label x:Name="ColorWheelTitle" Padding="12,10,0,0"
                       FontFamily="{StaticResource AtkinsonHyperlegible}"
                       Content="Theme Color" Foreground="#FFF0EBF5"
                       VerticalContentAlignment="Center" FontSize="13"
                       FontWeight="SemiBold" VerticalAlignment="Top" Height="40" />

                <Border Width="210" Height="210" Margin="0,50,0,0" HorizontalAlignment="Center"
                        VerticalAlignment="Top" CornerRadius="105"
                        Background="#FF1A1A2E" BorderThickness="1" BorderBrush="#FF3A3A55">
                    <Canvas x:Name="ColorWheelCanvas" Width="200" Height="200" Margin="5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MouseLeftButtonDown="ColorWheel_MouseDown" MouseMove="ColorWheel_MouseMove"
                            MouseLeftButtonUp="ColorWheel_MouseUp" Cursor="Cross">
                        <Ellipse Width="200" Height="200" x:Name="ColorWheelEllipse" />
                        <Grid x:Name="ColorSelector" Width="22" Height="22" Canvas.Left="89" Canvas.Top="89" IsHitTestVisible="False">
                            <Ellipse Width="22" Height="22" Stroke="{DynamicResource KN2Primary}" StrokeThickness="2">
<Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FF00A8FF" Opacity="0.5"/></Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="ColorDot" Width="10" Height="10" Fill="{DynamicResource KN2Primary}" Margin="6" />
                        </Grid>
                    </Canvas>
                </Border>

                <Grid Height="40" VerticalAlignment="Bottom" Margin="0,0,0,50">
                    <Border Background="#FF1A1A2E" CornerRadius="4" Margin="10,5" BorderThickness="1" BorderBrush="#FF2A2A40">
                        <Grid>
                            <Label Content="Brightness" Foreground="#FF8880A0"
                                   FontFamily="{StaticResource AtkinsonHyperlegible}"
                                   FontSize="11" Padding="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Grid Margin="80,0,53,0">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Black" Offset="0"/>
                                             <GradientStop x:Name="BrightnessGradientEnd" Color="#FF00A8FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="1"
                                        VerticalAlignment="Center" ValueChanged="BrightnessSlider_ValueChanged">
                                    <Slider.Style>
                                        <Style TargetType="Slider">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Slider">
                                                        <Grid><Track x:Name="PART_Track"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="14" Height="14" Fill="White" Stroke="{DynamicResource KN2Primary}" StrokeThickness="1"><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#FF00A8FF" Opacity="0.4"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Slider.Style>
                                </Slider>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,10,0">
                                <TextBox x:Name="BrightnessValue" Text="100"
                                         Foreground="#FF8880A0" Background="Transparent"
                                         FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="11"
                                         BorderBrush="{x:Null}" TextChanged="BrightnessValue_TextChanged" Width="25" />
                                <Label Content="%" Foreground="#FF8880A0"
                                       FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="11" Padding="0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Width="282.5" Height="50" VerticalAlignment="Bottom" CornerRadius="0"
                        Background="#08000000" BorderThickness="0,1,0,0" BorderBrush="#FF2A2A40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ColorPreview" Grid.Column="0" Width="30" Height="30"
                                  HorizontalAlignment="Center" Margin="10,0" Stroke="{DynamicResource KN2Primary}"
                                  StrokeThickness="1" Fill="{DynamicResource KN2Primary}">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FF00A8FF" Opacity="0.5"/></Ellipse.Effect>
                        </Ellipse>
                        <Border Grid.Column="1" Margin="0,10,10,10" Padding="5,0" VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <Label Content="Current Theme Color" Foreground="#FF8880A0"
                                       FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="11" Padding="0" Margin="0,0,0,2"/>
                                <TextBox x:Name="HexValue" Text="#B44CFF" Foreground="#FFF0EBF5"
                                         Background="Transparent"
                                         FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold"
                                         Padding="0" TextChanged="HexValue_TextChanged" BorderBrush="{x:Null}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Button x:Name="ArrowButton" Content=">" FontSize="16" FontWeight="Bold"
                        Foreground="#FF8880A0" Background="Transparent" BorderThickness="0"
                        Padding="10,0,15,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Visibility="Collapsed" Margin="0,-37,132,0" Click="ArrowButton_Click" />
                <Border x:Name="DragDropView" Background="#0F0F1A"
                        CornerRadius="6" BorderThickness="1" BorderBrush="#FF2A2A40" Visibility="Collapsed">
                    <Grid>
                        <Label Content="Media Control" Padding="12,10,0,0"
                               FontFamily="{StaticResource AtkinsonHyperlegible}"
                               Foreground="#FFF0EBF5" VerticalContentAlignment="Center" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Top" Height="40" />
                        <Grid Margin="20,50,20,20">
                            <Image x:Name="MediaPreviewImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <Border x:Name="DropZone" BorderThickness="2"
                                    CornerRadius="4"
                                    Background="#FF1A1A2E" AllowDrop="True">
                                <Border.BorderBrush>
                                    <VisualBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                        <VisualBrush.Visual>
                                            <Rectangle StrokeDashArray="1 2"
                                                       Stroke="#FF8880A0"
                                                       StrokeThickness="1" Width="8" Height="8"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.BorderBrush>
                                <TextBlock Text="Drag &amp; Drop Media Here" Foreground="#FF8880A0"
                                           FontFamily="{StaticResource AtkinsonHyperlegible}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
