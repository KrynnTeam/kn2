<UserControl x:Class="ShadowCheat.UILibrary.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48" MaxWidth="420">
    <Border x:Name="Root" CornerRadius="12" BorderThickness="1"
            Background="#1A0A0A" BorderBrush="#FF4A2020" Height="48">
        <Border.Effect>
            <DropShadowEffect Color="#CC0000" Opacity="0.3" BlurRadius="16" ShadowDepth="0"/>
        </Border.Effect>
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBorder" Grid.Column="0" Width="32" Height="32"
                    CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1ACC0000">
                <TextBlock x:Name="IconText" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" Foreground="#FFCC0000"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="MessageText" Grid.Column="1" 
                       FontFamily="Segoe UI" FontSize="13" Foreground="#FFF0EBF5"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Margin="4,0,12,0"/>
            <TextBlock x:Name="StatusText" Grid.Column="2" FontFamily="Segoe UI" FontSize="10"
                       Foreground="#FF8B0000" VerticalAlignment="Center" Margin="0,0,16,0"/>
        </Grid>
    </Border>
</UserControl>
