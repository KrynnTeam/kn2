<UserControl x:Class="ShadowCheat.UILibrary.ADisplaySelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="282.5" d:DesignHeight="200">
    <Grid>
        <Border Height="200" Background="#0F0F1A"
                CornerRadius="6" BorderThickness="1" BorderBrush="#FF2A2A40">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="8" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Label x:Name="DisplaySelectorTitle" Padding="12,10,0,0"
                       FontFamily="{StaticResource AtkinsonHyperlegible}"
                       Content="Focus Display" Foreground="#FFF0EBF5"
                       VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Top" Height="40" />
                <UniformGrid x:Name="DisplayGrid" Rows="2" Columns="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Width="260" Height="100" Margin="10,50,10,60" />
                <Border Height="50" VerticalAlignment="Bottom" CornerRadius="0"
                        Background="#0A000000" BorderThickness="0,1,0,0" BorderBrush="#FF2A2A40">
                    <Label x:Name="CurrentDisplayInfo"
                           FontFamily="{StaticResource AtkinsonHyperlegible}"
                           Content="No Display Selected" Foreground="#FF8880A0"
                           FontSize="12"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
