<Window x:Class="ShadowCheat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KN2"
        Height="640" MinHeight="640"
        Width="1000" MinWidth="1000"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="app.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="2" CaptionHeight="0" />
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- Notification overlay -->
        <StackPanel x:Name="NotificationLayer" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,12,0,0" ZIndex="100" IsHitTestVisible="False"/>

        <Border x:Name="MainBorder" CornerRadius="24" BorderBrush="#22CC0000" BorderThickness="1" SizeChanged="MainBorder_SizeChanged">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="8" ShadowDepth="5"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                            <SkewTransform CenterX="0.5" CenterY="0.5"/>
                            <RotateTransform x:Name="RotaryGradient" Angle="0" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF050000" Offset="0.2"/>
                    <GradientStop Color="#FF0A0505" Offset="0.5"/>
                    <GradientStop x:Name="GradientThemeStop" Color="#FF150A0A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Scanline overlay -->
                <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource Scanlines}" Opacity="0.08" IsHitTestVisible="False"
                           RadiusX="24" RadiusY="24"/>

                <!-- Hexagonal grid background -->
                <Rectangle Grid.ColumnSpan="2" x:Name="HexGrid" IsHitTestVisible="False" Opacity="0.03"
                           RadiusX="24" RadiusY="24">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,40,70" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Geometry="M20,0 L40,11.5 L40,34.5 L20,46 L0,34.5 L0,11.5 Z"
                                                       Brush="Transparent">
                                        <GeometryDrawing.Pen><Pen Brush="#FFCC0000" Thickness="0.5"/></GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ===== SIDEBAR ===== -->
                <Grid Grid.Column="0" ZIndex="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border x:Name="LogoBorder" Width="44" Height="44" Margin="0,18,0,0"
                            CornerRadius="14" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FFCC0000"/>
                                <GradientStop Offset="1" Color="#FF8B0000"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect x:Name="LogoGlow" Color="#CC0000" Opacity="0.5" BlurRadius="12" ShadowDepth="0"/>
                        </Border.Effect>
                        <TextBlock Text="K" FontFamily="Segoe UI" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="0" Height="1" Margin="14,12,14,0" VerticalAlignment="Bottom" Opacity="0.3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.5" Color="#FFCC0000"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Nav buttons -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <!-- Sliding active bar indicator (overlays buttons) -->
                        <Border x:Name="SliderBar" Width="3" Height="24" HorizontalAlignment="Left"
                                VerticalAlignment="Top" CornerRadius="0,3,3,0" Opacity="0"
                                IsHitTestVisible="False" Margin="0,19,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#FFCC0000"/>
                                    <GradientStop Offset="1" Color="#FF8B0000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#CC0000" Opacity="0.6" BlurRadius="6" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>

                        <StackPanel>
                        <!-- Inicio -->
                        <Button x:Name="Menu1B" Tag="HomePage" Width="80" Height="62"
                                BorderThickness="0" Background="Transparent" Click="MenuSwitch" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ActiveBar" Width="3" Height="24" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" CornerRadius="0,3,3,0" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FFCC0000"/>
                                                    <GradientStop Offset="1" Color="#FF8B0000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="BtnBg" Width="48" Height="48" CornerRadius="14"
                                                Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconText" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="#FF663333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentPresenter RecognizesAccessKey="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="#15CC0000" Duration="0:0:0.15"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FFF0EBF5" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FF663333" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip><ToolTip Content="Inicio" FontFamily="Segoe UI" FontSize="11"/></Button.ToolTip>
                        </Button>

                        <!-- Juegos -->
                        <Button x:Name="Menu2B" Tag="ModelMenu" Width="80" Height="62"
                                BorderThickness="0" Background="Transparent" Click="MenuSwitch" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ActiveBar" Width="3" Height="24" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" CornerRadius="0,3,3,0" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FFCC0000"/>
                                                    <GradientStop Offset="1" Color="#FF8B0000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="BtnBg" Width="48" Height="48" CornerRadius="14"
                                                Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconText" Text="&#xE7AC;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="#FF663333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentPresenter RecognizesAccessKey="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="#15CC0000" Duration="0:0:0.15"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FFF0EBF5" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FF663333" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip><ToolTip Content="Juegos" FontFamily="Segoe UI" FontSize="11"/></Button.ToolTip>
                        </Button>

                        <!-- Cheats -->
                        <Button x:Name="Menu3B" Tag="AimMenu" Width="80" Height="62"
                                BorderThickness="0" Background="Transparent" Click="MenuSwitch" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ActiveBar" Width="3" Height="24" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" CornerRadius="0,3,3,0" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FFCC0000"/>
                                                    <GradientStop Offset="1" Color="#FF8B0000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="BtnBg" Width="48" Height="48" CornerRadius="14"
                                                Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconText" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="#FF663333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentPresenter RecognizesAccessKey="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="#15CC0000" Duration="0:0:0.15"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FFF0EBF5" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FF663333" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip><ToolTip Content="Cheats" FontFamily="Segoe UI" FontSize="11"/></Button.ToolTip>
                        </Button>

                        <!-- Ajustes -->
                        <Button x:Name="Menu4B" Tag="SettingsMenu" Width="80" Height="62"
                                BorderThickness="0" Background="Transparent" Click="MenuSwitch" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ActiveBar" Width="3" Height="24" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" CornerRadius="0,3,3,0" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FFCC0000"/>
                                                    <GradientStop Offset="1" Color="#FF8B0000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="BtnBg" Width="48" Height="48" CornerRadius="14"
                                                Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconText" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="#FF663333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentPresenter RecognizesAccessKey="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="#15CC0000" Duration="0:0:0.15"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FFF0EBF5" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="BtnBg" Storyboard.TargetProperty="Background.Color" To="Transparent" Duration="0:0:0.2"/>
                                                        <ColorAnimation Storyboard.TargetName="IconText" Storyboard.TargetProperty="Foreground.Color" To="#FF663333" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip><ToolTip Content="Ajustes" FontFamily="Segoe UI" FontSize="11"/></Button.ToolTip>
                        </Button>

                        <!-- Acerca de -->
                        <Button x:Name="Menu5B" Tag="AcercaDe" Width="80" Height="62"
                                BorderThickness="0" Background="Transparent" Click="MenuSwitch" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ActiveBar" Width="3" Height="24" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" CornerRadius="0,3,3,0" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#FFCC0000"/>
                                                    <GradientStop Offset="1" Color="#FF8B0000"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="BtnBg" Width="48" Height="48" CornerRadius="14"
                                                Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconText" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="#FF663333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ContentPresenter RecognizesAccessKey="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBg" Property="Background" Value="#10FF0000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip><ToolTip Content="Acerca de" FontFamily="Segoe UI" FontSize="11"/></Button.ToolTip>
                        </Button>
                    </StackPanel>
                    </Grid>

                    <!-- Bottom controls -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <Border Height="1" Margin="14,0,14,10" Opacity="0.3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="Transparent"/>
                                    <GradientStop Offset="0.5" Color="#FFCC0000"/>
                                    <GradientStop Offset="1" Color="Transparent"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Button x:Name="Minimize" Width="80" Height="36"
                                Background="Transparent" BorderBrush="{x:Null}"
                                Foreground="{StaticResource NeonTextMuted}" FontFamily="Segoe MDL2 Assets"
                                Padding="0" BorderThickness="0" FontSize="10" Click="Minimize_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#CC0000" Opacity="0.2" BlurRadius="4" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#22CC0000"/>
                                            <Setter Property="Foreground" Value="#FFF0EBF5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="Exit" Width="80" Height="36"
                                Background="Transparent" BorderBrush="{x:Null}"
                                Foreground="{StaticResource NeonTextMuted}" FontFamily="Segoe MDL2 Assets"
                                Padding="0" BorderThickness="0" FontSize="10" Click="Exit_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#CC0000" Opacity="0.2" BlurRadius="4" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#22CC0000"/>
                                            <Setter Property="Foreground" Value="#FFFF2020"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Neon sidebar border -->
                    <Border Width="1" HorizontalAlignment="Right" Grid.RowSpan="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.1" Color="#FFCC0000"/>
                                <GradientStop Offset="0.5" Color="#FF8B0000"/>
                                <GradientStop Offset="0.9" Color="#FFCC0000"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect><BlurEffect Radius="2"/></Border.Effect>
                    </Border>
                </Grid>

                <!-- Right dashboard -->
                <Grid Grid.Column="1" Margin="8,8,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="16" Background="#06000000" BorderBrush="#14CC0000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#CC0000" Opacity="0.08" BlurRadius="20" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Dashboard header -->
                            <Border Grid.Row="0" Height="60" BorderBrush="#0DCC0000" BorderThickness="0,0,0,1"
                                    Background="#06000000" CornerRadius="16,16,0,0">
                                <Grid Margin="20,0,20,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashTitle" Text="Inicio" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NeonTextPrimary}" FontFamily="Segoe UI"/>
                                        <TextBlock x:Name="DashDesc" Text="Bienvenido a KN2" FontSize="11"
                                                   Foreground="{StaticResource NeonTextMuted}" FontFamily="Segoe UI"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="8"
                                            Background="#10CC0000" VerticalAlignment="Center">
                                        <TextBlock x:Name="DashIcon" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="#FFCC0000"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Page content -->
                            <Grid x:Name="ContentArea" Grid.Row="1" Margin="0,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
